{
  "name": "@royalsan/dsh-github-trending",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub Trending radar: fetch daily/weekly/monthly boards, analyze every repository, and render an interactive card report inside the Harness Web UI.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "github-trending",
    "bundle"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "cordis.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}